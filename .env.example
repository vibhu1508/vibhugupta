
# ── GitHub contribution graph (optional) ───────────────────────
# The contribution calendar is GraphQL-only, so it needs a token.
# A classic token with NO scopes ticked is sufficient for public counts.
# Unset = the graph simply doesn't render.
GITHUB_TOKEN=

# ── Contact email (optional but recommended) ───────────────────
# Resend: 3,000 emails/month free. https://resend.com
# Verify your domain, then set FROM to an address on it.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=hello@yourdomain.com
# Where messages land. Defaults to profile.email if unset.
CONTACT_TO_EMAIL=
